{% doc %}
  @prompt
    multimedia collage
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multimedia-collage-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-multimedia-collage__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-multimedia-collage__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    position: relative;
  }

  .ai-multimedia-collage__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.item_background }};
  }

  .ai-multimedia-collage__item-1-{{ ai_gen_id }} {
    grid-column: span 7;
    grid-row: span 2;
  }

  .ai-multimedia-collage__item-2-{{ ai_gen_id }} {
    grid-column: span 5;
    grid-row: span 1;
  }

  .ai-multimedia-collage__item-3-{{ ai_gen_id }} {
    grid-column: span 5;
    grid-row: span 1;
  }

  .ai-multimedia-collage__item-4-{{ ai_gen_id }} {
    grid-column: span 4;
    grid-row: span 1;
  }

  .ai-multimedia-collage__item-5-{{ ai_gen_id }} {
    grid-column: span 8;
    grid-row: span 1;
  }

  .ai-multimedia-collage__media-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 300px;
  }

  .ai-multimedia-collage__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-multimedia-collage__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-multimedia-collage__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 300px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-multimedia-collage__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-multimedia-collage__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }

  .ai-multimedia-collage__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: {{ block.settings.content_padding }}px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-multimedia-collage__item-{{ ai_gen_id }}:hover .ai-multimedia-collage__overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-multimedia-collage__title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .ai-multimedia-collage__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0 0 16px;
    line-height: 1.4;
  }

  .ai-multimedia-collage__link-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 20px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    transition: background-color 0.3s ease;
  }

  .ai-multimedia-collage__link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 989px) {
    .ai-multimedia-collage__item-1-{{ ai_gen_id }},
    .ai-multimedia-collage__item-2-{{ ai_gen_id }},
    .ai-multimedia-collage__item-3-{{ ai_gen_id }},
    .ai-multimedia-collage__item-4-{{ ai_gen_id }},
    .ai-multimedia-collage__item-5-{{ ai_gen_id }} {
      grid-column: span 6;
      grid-row: span 1;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-multimedia-collage__item-1-{{ ai_gen_id }},
    .ai-multimedia-collage__item-2-{{ ai_gen_id }},
    .ai-multimedia-collage__item-3-{{ ai_gen_id }},
    .ai-multimedia-collage__item-4-{{ ai_gen_id }},
    .ai-multimedia-collage__item-5-{{ ai_gen_id }} {
      grid-column: span 12;
    }

    .ai-multimedia-collage__media-wrapper-{{ ai_gen_id }} {
      min-height: 250px;
    }

    .ai-multimedia-collage__overlay-{{ ai_gen_id }} {
      opacity: 1;
    }
  }
{% endstyle %}

<div class="ai-multimedia-collage-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-multimedia-collage__container-{{ ai_gen_id }}">
    <div class="ai-multimedia-collage__grid-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign image_key = 'item_' | append: i | append: '_image'
          assign video_key = 'item_' | append: i | append: '_video'
          assign title_key = 'item_' | append: i | append: '_title'
          assign description_key = 'item_' | append: i | append: '_description'
          assign link_key = 'item_' | append: i | append: '_link'
          assign link_text_key = 'item_' | append: i | append: '_link_text'
          assign media_type_key = 'item_' | append: i | append: '_media_type'

          assign item_image = block.settings[image_key]
          assign item_video = block.settings[video_key]
          assign item_title = block.settings[title_key]
          assign item_description = block.settings[description_key]
          assign item_link = block.settings[link_key]
          assign item_link_text = block.settings[link_text_key]
          assign media_type = block.settings[media_type_key]
        %}

        <div class="ai-multimedia-collage__item-{{ ai_gen_id }} ai-multimedia-collage__item-{{ i }}-{{ ai_gen_id }}">
          <div class="ai-multimedia-collage__media-wrapper-{{ ai_gen_id }}">
            {% if media_type == 'image' %}
              {% if item_image %}
                <img
                  src="{{ item_image | image_url: width: 1200 }}"
                  alt="{{ item_image.alt | escape }}"
                  loading="lazy"
                  width="{{ item_image.width }}"
                  height="{{ item_image.height }}"
                  class="ai-multimedia-collage__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-multimedia-collage__placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                  <div class="ai-multimedia-collage__empty-state-{{ ai_gen_id }}">
                    Add an image
                  </div>
                </div>
              {% endif %}
            {% elsif media_type == 'video' %}
              {% if item_video %}
                <video
                  class="ai-multimedia-collage__video-{{ ai_gen_id }}"
                  autoplay
                  muted
                  loop
                  playsinline
                >
                  <source src="{{ item_video }}" type="video/mp4">
                </video>
              {% else %}
                <div class="ai-multimedia-collage__placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                  <div class="ai-multimedia-collage__empty-state-{{ ai_gen_id }}">
                    Add a video URL
                  </div>
                </div>
              {% endif %}
            {% endif %}

            {% if item_title != blank or item_description != blank or item_link != blank %}
              <div class="ai-multimedia-collage__overlay-{{ ai_gen_id }}">
                {% if item_title != blank %}
                  <h3 class="ai-multimedia-collage__title-{{ ai_gen_id }}">{{ item_title }}</h3>
                {% endif %}
                {% if item_description != blank %}
                  <div class="ai-multimedia-collage__description-{{ ai_gen_id }}">{{ item_description }}</div>
                {% endif %}
                {% if item_link != blank and item_link_text != blank %}
                  <a href="{{ item_link }}" class="ai-multimedia-collage__link-{{ ai_gen_id }}">
                    {{ item_link_text }}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

